{
  "expo": {
    "name": "tripnote",
    "slug": "tripnote",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tripnote",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.example.tripnote",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-task-manager",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "지도에 현재 위치를 표시하고 도착을 기록하기 위해 위치를 사용합니다",
          "locationAlwaysAndWhenInUsePermission": "일정에 있는 장소에 도착한 시간을 자동으로 기록하기 위해 위치를 사용합니다",
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "expo-notifications",
      [
        "expo-media-library",
        {
          "photosPermission": "방문한 곳에 사진을 남기기 위해 사진첩에 접근합니다",
          "savePhotosPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "방문한 곳에 사진을 남기기 위해 사진첩에 접근합니다",
          "cameraPermission": "방문한 곳에서 사진을 찍어 기록하기 위해 카메라를 사용합니다"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
